{
  "name": "pharn-ci-monorepo",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check . && pnpm -r typecheck",
    "format": "biome check --write .",
    "pharn-ci": "node packages/cli/dist/index.js",
    "phargus:install": "npm install --prefix .phargus --no-save --no-package-lock --ignore-scripts --no-audit --no-fund @pharn-dev/phargus@0.1.0",
    "phargus:check": "PHARGUS_OUTPUT=\"$PWD/.phargus/raw.ndjson\" PHARGUS_INTERVAL_MS=100 node --import ./.phargus/node_modules/@pharn-dev/phargus/dist/esm/agent/auto.js packages/cli/dist/index.js check",
    "phargus:collect": "node .phargus/tools/phargus.mjs collect --project \"$PWD/.phargus\" --file \"$PWD/.phargus/raw.ndjson\" --follow"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vitest": "5.1.0"
  }
}
