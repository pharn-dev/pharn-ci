{
  "name": "pharn-ci-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check . && pnpm -r typecheck",
    "format": "biome check --write .",
    "pharn-ci": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.0.4",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vitest": "5.0.4"
  }
}
