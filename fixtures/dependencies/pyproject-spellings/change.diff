+name = "app"
+version = "0.1.0"
+requires-python = ">=3.11"
+dependencies = ["requests>=2.31", "torch>=2.4"]
+
+[[tool.uv.index]]
+name = "pypi-simple"
+url = "https://pypi.org/simple/"
+explicit = true
+
