{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{{S01}}" }
    },
    "pair": { "env": { "FIRST_TOKEN": "{{S01}}", "SECOND_TOKEN": "{{S01}}" } },
    "anthropic": { "env": { "ANTHROPIC_API_KEY": "{{S02}}" } },
    "openai": { "env": { "OPENAI_API_KEY": "{{S03}}" } },
    "maps": { "env": { "GOOGLE_API_KEY": "{{S04}}" } },
    "cloud": { "env": { "AWS_ACCESS_KEY_ID": "{{S05}}" } },
    "chat": { "env": { "SLACK_BOT_TOKEN": "{{S06}}" } },
    "billing": { "env": { "STRIPE_SECRET_KEY": "{{S07}}" } },
    "database": { "env": { "DATABASE_URL": "{{S09}}" } },
    "service": {
      "url": "https://api.internal.io/v1",
      "headers": {
        "apiKey": "{{S10}}",
        "x-api-key": "{{S10}}",
        "authorization": "Bearer {{S10}}"
      },
      "args": ["--api-key", "{{S10}}"]
    }
  }
}
