@@ -0,0 +1,16 @@
+import { describe, expect, it } from "vitest";
+import { priceOrder } from "./pricing.js";
+
+describe("pricing", () => {
+  it("applies a bulk discount to large orders", () => {
+    const items = [{ qty: 100, price: 2 }];
+    const result = priceOrder(items);
+    expect(result.discount).toBe(0.2);
+    expect(result.total).toBeTruthy();
+  });
+
+  it("charges full price for small orders", () => {
+    const order = { qty: 1, price: 2, coupon: "SAVE5" };
+    const total = priceOrder([order]).total;
+    expect(total).toBe(2);
+  });
+});
