<?xml version="1.0" encoding="UTF-8"?>
<!-- Filled at test time: SEEDED_ATTR is the seeded secrets XML-escaped for an attribute, SEEDED_TEXT for text. No real
     secret is committed (gitleaks, GitHub push protection). -->
<testsuites>
  <testsuite name="suite SEEDED_ATTR">
    <testcase classname="secrets.attr" name="message attribute" time="0.1">
      <failure message="SEEDED_ATTR" type="Error"/>
    </testcase>
    <testcase classname="secrets.text" name="failure text" time="0.1">
      <error>SEEDED_TEXT</error>
    </testcase>
    <testcase classname="secrets.cdata" name="failure cdata" time="0.1">
      <failure><![CDATA[SEEDED_CDATA]]></failure>
    </testcase>
    <testcase classname="secrets.name SEEDED_ATTR" name="name SEEDED_ATTR" time="0.1"/>
    <testcase classname="secrets.output" name="output" time="0.1">
      <system-out>SEEDED_TEXT</system-out>
      <system-err><![CDATA[SEEDED_CDATA]]></system-err>
    </testcase>
  </testsuite>
</testsuites>
