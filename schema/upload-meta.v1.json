{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharn.dev/schemas/ci/upload-meta.v1.json",
  "title": "pharn-ci upload metadata, version 1",
  "description": "The meta.json file of a run bundle that the Action uploads to pharn.dev: the run metadata of the report plus the tool, the time and the link to the pull request comment. Shared by the Action and the app; every object is closed. The report.json of the same bundle is a Report v2 (schema/report.v2.json) whose signal excerpts are dropped and whose meta.upload says ok.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "createdAt",
    "event",
    "repository",
    "prNumber",
    "headSha",
    "baseSha",
    "mergeBase",
    "scope",
    "runId",
    "runAttempt",
    "commentUrl"
  ],
  "properties": {
    "schemaVersion": {
      "description": "The version of this document; the number 1.",
      "type": "integer",
      "const": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "pharn-ci" },
        "version": { "description": "The pharn-ci version that wrote the bundle.", "type": "string", "minLength": 1 }
      }
    },
    "createdAt": {
      "description": "UTC time the bundle was made, as an ISO 8601 text ending in Z, with an optional fraction of a second.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "event": {
      "enum": ["pull_request", "merge_group", "push", "workflow_run", "workflow_dispatch", "other"]
    },
    "repository": { "description": "owner/name", "type": "string", "minLength": 1 },
    "repositoryId": { "type": "integer" },
    "prNumber": { "type": ["integer", "null"], "minimum": 1 },
    "headSha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "baseSha": { "type": ["string", "null"] },
    "mergeBase": { "type": ["string", "null"] },
    "scope": { "description": "workflow/job", "type": "string" },
    "runId": { "type": "integer" },
    "runAttempt": { "type": "integer", "minimum": 1 },
    "actor": { "type": "string" },
    "prAuthor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["login", "type"],
          "properties": {
            "login": { "type": "string" },
            "type": { "enum": ["User", "Bot", "Organization"] }
          }
        }
      ]
    },
    "prLabels": { "type": "array", "items": { "type": "string" } },
    "coAuthors": { "type": "array", "items": { "type": "string" } },
    "agentHint": { "type": ["string", "null"] },
    "isAgentPr": { "type": "boolean" },
    "commentUrl": {
      "description": "The link to the pull request comment of this run, or null when the run has none.",
      "type": ["string", "null"]
    }
  }
}
